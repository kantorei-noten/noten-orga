# Vorlage. Normalerweise nicht von Hand anlegen — ./setup.sh erzeugt eine .env mit
# zufällig erzeugten Geheimnissen. Diese Datei zeigt, welche Schalter es gibt.
# Die .env selbst gehört NICHT ins Git (.gitignore/.dockerignore schließen sie aus).

# --- Geheimnisse (Pflicht) ---
# Starkes DB-Passwort           (openssl rand -hex 24)
NOTEN_DB_PASSWORD=BITTE_STARKES_PASSWORT
# Sitzungs-Signaturschlüssel    (openssl rand -hex 32)
NOTEN_SESSION_SECRET=BITTE_ZUFALLSWERT

# --- Erreichbarkeit ---
# Öffentliche Domain -> Caddy holt automatisch ein Let's-Encrypt-Zertifikat.
# Leer lassen für lokalen Betrieb auf :80 (z. B. hinter eigenem TLS-Terminator).
NOTEN_DOMAIN=noten.example.org
# Sitzungs-Cookies nur über HTTPS senden. Bei Betrieb ohne TLS auf false, sonst kein Login.
NOTEN_SECURE_COOKIES=true
# Host-Ports für Caddy. Nur nötig, wenn 80/443 schon belegt sind (z. B. NAS mit
# eigener Weboberfläche/Gitea). Default = 80/443.
# NOTEN_HTTP_PORT=8090
# NOTEN_HTTPS_PORT=8453

# --- Images ---
# Welcher Stand geladen wird: "latest" oder ein Release-Tag wie v0.1.0 (empfohlen für Produktion).
NOTEN_VERSION=latest
# Nur für Forks/eigene Registry:
# NOTEN_IMAGE_BASE=ghcr.io/kantorei-noten/noten-orga

# --- Anmeldung ---
# Pflicht-2FA (TOTP) für alle Konten. Nur zum Ausprobieren abschalten.
NOTEN_TOTP_PFLICHT=true

# --- Sicherung (Container "backup") ---
# Ziel: Host-Pfad (empfohlen, z. B. /mnt/backup/kantorei) oder das Volume "backups".
NOTEN_BACKUP_DIR=backups
NOTEN_BACKUP_UHRZEIT=03:30
NOTEN_BACKUP_KEEP_DAYS=14
# Zeitzone für die Sicherungs-Uhrzeit (ohne sie läuft sie nach UTC).
TZ=Europe/Berlin

# --- Nur beim Selberbauen (compose.build.yaml) ---
# AGPL §13: eigenes, öffentlich erreichbares Repository eines Forks.
# NOTEN_QUELLCODE_URL=https://github.com/dein-name/dein-fork
